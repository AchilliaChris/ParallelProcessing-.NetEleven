<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Features>runtime-async=on</Features>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0-rc.1.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.1.*" />
  </ItemGroup>

</Project>
